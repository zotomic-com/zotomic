# ============================================================
# ZOTOMIC — ENVIRONMENT VARIABLES
# Copy to .env.local and fill in real values.
# ============================================================

# ── Supabase (required) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string (for `supabase db push` / migrations)
SUPABASE_DB_URL=

# ── Auth / crypto (required) ────────────────────────────────
# 32+ char random string — signs session JWTs
AUTH_JWT_SECRET=
# EXACTLY 32 chars — AES-256-CBC key for stored third-party credentials
ENCRYPTION_KEY=

# ── Site ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://zotomic.com
# Root domain for tenant storefronts -> <slug>.STOREFRONT_ROOT_DOMAIN
STOREFRONT_ROOT_DOMAIN=zotomic.store

# ── AI (Weekly Intelligence narrative) ──────────────────────
GEMINI_API_KEY=

# ── Cloudinary (media pipeline) ─────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Hermes agent engine (Phase 6 — separate VPS) ────────────
HERMES_BASE_URL=
HERMES_SHARED_SECRET=

# ── Email ───────────────────────────────────────────────────
RESEND_API_KEY=
NOTIFICATION_EMAIL=hello@zotomic.com
EMAIL_DOMAIN=zotomic.com
BREVO_API_KEY=

# ── WhatsApp Business (report push — optional) ──────────────
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=

# ── Payments — bKash sandbox (Phase 7) ─────────────────────
BKASH_SANDBOX_BASE_URL=
BKASH_SANDBOX_APP_KEY=
BKASH_SANDBOX_APP_SECRET=
BKASH_SANDBOX_USERNAME=
BKASH_SANDBOX_PASSWORD=
