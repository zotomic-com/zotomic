# ============================================================
# ZOTOMIC — ENVIRONMENT VARIABLES
# Copy to .env.local and fill in real values.
# ============================================================

# ── Supabase (required) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string (for `supabase db push` / migrations)
SUPABASE_DB_URL=

# ── Auth / crypto (required) ────────────────────────────────
# 32+ char random string — signs session JWTs
AUTH_JWT_SECRET=
# EXACTLY 32 chars — AES-256-CBC key for stored third-party credentials
ENCRYPTION_KEY=

# ── Site ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://zotomic.com
# Root domain for tenant storefronts -> <slug>.STOREFRONT_ROOT_DOMAIN
STOREFRONT_ROOT_DOMAIN=zotomic.com

# ── AI (Weekly Intelligence narrative) ──────────────────────
GEMINI_API_KEY=
# Daily Gemini call ceilings (backstop against runaway loops; optional, sane defaults)
AI_DAILY_LIMIT_PER_BUSINESS=500
AI_DAILY_LIMIT_GLOBAL=8000

# ── Cloudinary (media pipeline) ─────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Hermes agent engine (Phase 6 — separate VPS) ────────────
HERMES_BASE_URL=
HERMES_SHARED_SECRET=

# ── Email (Google Workspace SMTP — one App Password per identity) ──
# Each MAIL_<X>_PASS is a Google "App Password" generated on that mailbox
# (2FA required). An account falls back to GMAIL_* if its pair is unset.
MAIL_INVOICE_USER=invoice@zotomic.com
MAIL_INVOICE_PASS=
MAIL_ADMIN_USER=admin@zotomic.com
MAIL_ADMIN_PASS=
MAIL_SUPPORT_USER=support@zotomic.com
MAIL_SUPPORT_PASS=
MAIL_INFO_USER=info@zotomic.com
MAIL_INFO_PASS=
NOTIFICATION_EMAIL=admin@zotomic.com
SUPPORT_EMAIL=support@zotomic.com
# legacy single-account fallback
GMAIL_USER=zotomic.com@gmail.com
GMAIL_APP_PASSWORD=
EMAIL_FROM=Zotomic <zotomic.com@gmail.com>
# optional: verified "send mail as" alias for assistant-sent report emails
EMAIL_ASSISTANT_FROM=

# ── WhatsApp Business (report push — optional) ──────────────
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=

# ── Payments — bKash sandbox (Phase 7) ─────────────────────
BKASH_SANDBOX_BASE_URL=
BKASH_SANDBOX_APP_KEY=
BKASH_SANDBOX_APP_SECRET=
BKASH_SANDBOX_USERNAME=
BKASH_SANDBOX_PASSWORD=
